DATABASE_URL="postgresql://passkey:passkey@localhost:5432/passkey_demo?schema=public"

# WebAuthn Relying Party
# RP_ID ต้องเป็น domain ล้วน ๆ (ไม่มี http, ไม่มี port) และ ORIGIN ต้องเป็น suffix ของมัน
RP_ID="localhost"
RP_NAME="Passkey Demo"
ORIGIN="http://localhost:3000"

# สวิตช์ demo: remoteDevice = โชว์ QR ให้มือถือสแกน, localDevice = Windows Hello, ว่าง = ให้เบราว์เซอร์เลือก
# ใช้กับ iPhone ต้องเปิดผ่าน HTTPS domain จริง (devtunnel) แล้วตั้ง RP_ID / ORIGIN ให้ตรงกับ domain นั้น
PASSKEY_PREFER=""
